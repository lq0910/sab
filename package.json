{
  "name": "sab",
  "version": "0.1.0",
  "// buildNumber": "功能：标记首个 macOS 预览构建；时间：2026-11-14；作者：lq。",
  "buildNumber": "2026111402",
  "private": true,
  "type": "module",
  "//": "功能：工程命令与精确依赖清单；时间：2026-11-08；作者：lq。",
  "description": "轻页 SAB — 本地优先的轻量桌面浏览器",
  "author": "lq",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.33.2",
  "engines": { "node": ">=22.12.0", "pnpm": ">=10" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "cargo:check": "cargo check --manifest-path src-tauri/Cargo.toml --locked",
    "cargo:test": "cargo test --manifest-path src-tauri/Cargo.toml --locked",
    "verify": "pnpm typecheck && pnpm test && pnpm build && pnpm cargo:test",
    "release:mac": "node scripts/release-macos.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "vue": "3.5.45"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "22.20.5",
    "@vitejs/plugin-vue": "6.0.10",
    "typescript": "5.9.3",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "vue-tsc": "3.3.14"
  }
}
